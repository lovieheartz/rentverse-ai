# Example configuration for local development.
#
# Copy this file to server/config/.config.env and fill in what you need.
# That file is gitignored and must never be committed - see docs/SECURITY.md.
#
#   cp server/config/config.env.example server/config/.config.env
#
# Nothing below is required to run the app. With no AI keys set, the analysis feature
# serves a clearly-labelled deterministic sample so the whole flow stays demoable.

# ---------------------------------------------------------------- core server

NODE_ENV=development
PORT=3099

# Comma-separated origins allowed to call the API from a browser.
# Only needed when the UI is served from a different origin than the API;
# `npm start` proxies /api, so this is a safety net.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Maximum accepted request body size.
JSON_BODY_LIMIT=100kb

# ------------------------------------------------------------------ database
#
# Optional. The property catalogue and the AI endpoints do not use MongoDB.
# It is only needed by the legacy /api/product, /api/order, /api/payment and
# /api/user routes, which answer 503 while it is unset.

# MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/rentverse

# ------------------------------------------------------- AI provider selection
#
# `auto` (default) uses the first configured provider in AI_PROVIDER_ORDER, and
# falls back to the deterministic sample provider when none are configured.
# Set an explicit id to pin one: anthropic | openai | google | mistral | groq |
# deepseek | xai | openrouter | cohere | ollama | sample
AI_PROVIDER=auto

# Priority order for auto-selection and for failover.
AI_PROVIDER_ORDER=anthropic,openai,google,mistral,groq,xai,deepseek,openrouter,cohere,ollama

# When a provider errors or its output fails the quality gate, try the next one.
AI_FAILOVER=true
AI_MAX_FAILOVER_PROVIDERS=3

# How many providers a single /compare request may fan out to.
AI_MAX_COMPARE_PROVIDERS=6

# ------------------------------------------------------------ provider credentials
#
# Set any one of these to enable that provider. Model ids are sensible defaults;
# vendors rename and retire models on their own schedule, so override the matching
# *_MODEL variable rather than editing code. GET /api/ai/providers shows exactly
# which model each provider will use.

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5

# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-pro

# MISTRAL_API_KEY=...
# MISTRAL_MODEL=mistral-large-latest

# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat

# XAI_API_KEY=xai-...
# XAI_MODEL=grok-4

# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-5

# COHERE_API_KEY=...
# COHERE_MODEL=command-a-03-2025

# Local models through Ollama. Setting the base URL is what enables it.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.1

# ------------------------------------------------------------ AI request tuning

# Anthropic only: reasoning depth. low | medium | high | xhigh | max
AI_EFFORT=medium

# Anthropic only: let the API re-run a policy-declined request on a fallback model.
AI_REFUSAL_FALLBACK=true

AI_MAX_TOKENS=16000
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=90000
AI_MAX_RETRIES=2

# Per-provider token override, e.g. GROQ_MAX_TOKENS=8000

# Regeneration attempts when the quality gate rejects an output (1 = no retry).
AI_MAX_QUALITY_ATTEMPTS=2

# Server-side cache for identical analysis requests.
AI_CACHE_TTL_MS=600000
AI_CACHE_MAX_ENTRIES=200

# Per-client rate limits. Each analysis is a paid upstream call.
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20
AI_COMPARE_RATE_LIMIT_MAX=5

# ------------------------------------------------------------------ cloudinary
#
# Optional, used only by the legacy product/user image uploads.

# CLOUDINARY_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
